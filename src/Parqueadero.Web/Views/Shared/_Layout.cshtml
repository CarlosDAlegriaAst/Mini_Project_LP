<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Parqueadero</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">P · Parqueadero</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
      <div id="menu" class="collapse navbar-collapse">
        <ul class="navbar-nav me-auto">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <li class="nav-item"><a class="nav-link" asp-controller="Parqueadero" asp-action="Index">Panel</a></li>
            @if (User.IsInRole("Admin"))
            {
              <li class="nav-item"><a class="nav-link" asp-controller="Parqueadero" asp-action="Historial">Historial</a></li>
              <li class="nav-item"><a class="nav-link" asp-controller="Tarifas" asp-action="Index">Tarifas</a></li>
            }
          }
        </ul>
        <ul class="navbar-nav">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <li class="nav-item"><span class="nav-link text-light">@User.Identity.Name</span></li>
            <li class="nav-item">
              <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                <button class="btn btn-outline-light btn-sm mt-1" type="submit">Salir</button>
              </form>
            </li>
          }
          else
          {
            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Ingresar</a></li>
          }
        </ul>
      </div>
    </div>
  </nav>
  <main class="container py-4">
    @if (TempData["ok"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["error"] is string er) { <div class="alert alert-warning">@er</div> }
    @RenderBody()
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
